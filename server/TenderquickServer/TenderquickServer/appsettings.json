{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MyConnection": "server=localhost;port=3306;database=<db_name>;user=<db_user>;password=<db_password>"
  },
  "AllowedOrigins": [
    "http://localhost:5173"
  ],
